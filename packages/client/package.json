{
  "name": "@ragtime/client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the RAGtime worker: every corpus route the public frontend calls, the Explorer turn stream, the corpus registry, and the deep-link grammar.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomkav/ragtime-explorer.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "test:live": "EXPLORER_LIVE=1 node --test test/live.test.ts"
  },
  "sideEffects": false
}
